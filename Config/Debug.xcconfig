// Local development: simulator talks to the backend on this Mac.
AIDROBE_APP_ENV = development
AIDROBE_API_BASE_URL = http:/$()/localhost:8000
AIDROBE_DEV_USER_ID = 00000000-0000-4000-8000-000000000001
AIDROBE_ENABLE_V3_PURCHASE_DECISION = YES
AIDROBE_ENABLE_V3_AVATAR = YES
AIDROBE_ENABLE_V3_STATIC_TRYON = YES
AIDROBE_ENABLE_V3_ANALYTICS = NO
